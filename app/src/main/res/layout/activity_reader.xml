<?xml version="1.0" encoding="utf-8"?>
<!--
    The reader.

    The cover holds the top of the screen at rest, then scrolls away and fades
    as the reader moves down the story, leaving the whole screen for text. The
    back and font buttons stay pinned the entire time.

    The story title is NOT in this file. It is the first item of the
    RecyclerView, so it scrolls up with the text rather than sitting in a fixed
    band. ReaderActivity joins the header and the body with a ConcatAdapter.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper_edge"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <!--
            The height here is a placeholder. ReaderActivity sets it to the
            cover height plus the status bar inset at runtime, so the artwork
            keeps its full height on a device that draws behind the status bar.
        -->
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:layout_width="match_parent"
            android:layout_height="@dimen/reader_cover_height"
            app:contentScrim="@color/paper"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:scrimAnimationDuration="200"
            app:titleEnabled="false">

            <ImageView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/paper_edge"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.5"
                tools:src="@drawable/cover_01" />

            <!-- Keeps the white controls readable over a bright cover. -->
            <View
                android:id="@+id/coverScrim"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_cover_scrim"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.5" />

            <FrameLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                app:layout_collapseMode="pin">

                <ImageButton
                    android:id="@+id/back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_round_button"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_arrow_back" />

                <!--
                    Appears only once the cover has scrolled away, so the
                    reader can still see which story they are in.
                -->
                <TextView
                    android:id="@+id/collapsedTitle"
                    style="@style/Text.Display"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="112dp"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="17sp"
                    tools:text="केसर की सुबह" />

                <ImageButton
                    android:id="@+id/share"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="56dp"
                    android:background="@drawable/bg_round_button"
                    android:contentDescription="@string/action_share"
                    android:src="@drawable/ic_share" />

                <TextView
                    android:id="@+id/fontSize"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_round_button"
                    android:clickable="true"
                    android:contentDescription="@string/action_font_size"
                    android:focusable="true"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/glyph_font_size"
                    android:textColor="@color/paper"
                    android:textSize="19sp" />

            </FrameLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!--
        The rounded sheet. The negative top margin lifts it over the bottom of
        the cover, so the artwork runs under the corners instead of stopping
        at a hard edge.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/blocks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/reader_sheet_overlap"
        android:background="@drawable/bg_sheet_top"
        android:clipToPadding="false"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
