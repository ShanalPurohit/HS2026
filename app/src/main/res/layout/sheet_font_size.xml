<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="26dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/font_size_title"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepLabel"
            style="@style/Text.Accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            tools:text="मध्यम" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/smaller"
            android:layout_width="60dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_step_button"
            android:clickable="true"
            android:contentDescription="@string/action_smaller"
            android:focusable="true"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="@string/glyph_smaller"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot0"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/dot_inactive" />

            <ImageView
                android:id="@+id/dot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/dot_inactive" />

            <ImageView
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/dot_active" />

            <ImageView
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/dot_inactive" />

            <ImageView
                android:id="@+id/dot4"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/dot_inactive" />

        </LinearLayout>

        <TextView
            android:id="@+id/bigger"
            android:layout_width="60dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_step_button"
            android:clickable="true"
            android:contentDescription="@string/action_bigger"
            android:focusable="true"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="@string/glyph_bigger"
            android:textColor="@color/ink"
            android:textSize="21sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/preview"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_preview"
        android:padding="16dp"
        android:text="@string/font_size_preview" />

    <TextView
        android:id="@+id/done"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/action_done"
        android:textColor="@color/card"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
