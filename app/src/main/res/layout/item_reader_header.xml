<?xml version="1.0" encoding="utf-8"?>
<!--
    The story title and reading time, as the first row of the reader list.

    This used to sit in a fixed band in the activity. Putting it in the list
    means it scrolls away with the text, so a reader who has settled into the
    story gets the whole screen. The title comes back in the toolbar once the
    cover has collapsed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        style="@style/Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="26sp"
        tools:text="केसर की सुबह" />

    <TextView
        android:id="@+id/minutes"
        style="@style/Text.Accent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="13sp"
        tools:text="3 मिनट" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="20dp"
        android:background="@color/hairline" />

</LinearLayout>
